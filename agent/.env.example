# sagak profile의 .env에 들어가는 이름 (값은 Hermes 대시보드나 `hermes -p sagak config set`으로 입력)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
VOICE_TOOLS_OPENAI_KEY=
# 사각사각 전사용 OpenAI 키 (Hermes 자체 음성 키와 별도 이름이어야 전달됨)
SAGAK_OPENAI_STT_KEY=
NOTION_API_KEY=
# Notion DB ID (비밀값 아님, 고객사마다 다름)
SAGAK_NOTION_CUSTOMERS_DB=
SAGAK_NOTION_EVENTS_DB=
SAGAK_NOTION_CONSULTATIONS_DB=
# STT 모델 (기본 gpt-4o-transcribe-diarize, 비우면 기본값)
SAGAK_STT_MODEL=
